; mibi configuration.
;
; Copy this file to `mibi.ini` next to the binary, or into the directory you
; run mibi from. Every key is optional: unset values keep the defaults, and
; unknown keys are ignored.

[editor]
; Cells a tab advances to (clamped to 1-16).
tab_width = 4
; Line numbers in the left gutter.
line_numbers = true
; Fold long lines at the pane's width instead of scrolling sideways
; (alt+z switches it while editing).
soft_wrap = false
; Syntax highlighting from syntax.d/*.ini.
syntax = true
; Ask the terminal for the kitty keyboard protocol (ctrl+shift chords and
; Escape arrive unambiguously). Off by default; works in kitty, foot, WezTerm,
; Ghostty and other terminals that implement it, and is ignored elsewhere.
kitty_keys = false
; Colour theme from themes/<name>.ini (see themes/README.md).
; theme = catppuccin-mocha

[theme]
; Colours are #rrggbb or #rgb. Uncomment to override the default palette.
; background = #0e0e0e   ; unset keeps the terminal's own background
; line_hl = #1c1b1a     ; current-line tint (derived from bg/text when unset)
; text = #d8dee9
; gutter = #5c6370
; selection = #334566
; bar_bg = #282838
; accent = #8bd450
; hint_bg = #1e1e2a
; hint_fg = #8892a4
; tab_bg = #1e1e2a
; tab_active_bg = #334566
; help_bg = #1a1a24
; comment = #6a7382
; keyword1 = #c678dd
; keyword2 = #e5c07b
; string = #98c379
; number = #d19a66

[keys]
; Bind an action to a key. Modifiers: ctrl, alt, shift.
; A binding replaces the default key of that action. Shift with a movement
; key extends the selection without being bound. Actions:
;   save save_as open new_tab close_tab next_tab prev_tab quit undo redo copy
;   cut paste duplicate_line delete_line move_line_up move_line_down
;   toggle_comment indent dedent insert_newline insert_tab backspace
;   delete_forward delete_word_back delete_word_forward format filter
;   select_all clear_selection add_cursor_above add_cursor_below move_up
;   move_down move_left move_right move_word_left move_word_right move_home
;   move_end page_up page_down move_doc_start move_doc_end move_bracket find
;   find_next find_prev replace goto command_palette theme_picker toggle_tree
;   toggle_wrap help split_columns split_rows close_pane next_pane prev_pane
; ctrl+n = new_tab
; f2 = save
; ctrl+shift+left = move_word_left
; Formatting: one command per file extension. mibi runs it with the buffer on
; stdin and replaces the buffer with what it prints, so any formatter works.
; `{file}` is replaced by the file's path (tools use it to pick a parser).
; F4 formats now; on_save = true also formats before every save.
; A missing tool, a non-zero exit, empty output or a 10 s timeout is reported
; in the status line and the buffer is left untouched.
[format]
; on_save = false
; js   = prettier --stdin-filepath {file}
; ts   = prettier --stdin-filepath {file}
; json = prettier --stdin-filepath {file}
; md   = prettier --stdin-filepath {file}
; css  = biome format --stdin-file-path {file}
; zig  = zig fmt --stdin
; py   = black -q -
; go   = gofmt
; rs   = rustfmt
; c    = clang-format
; sh   = shfmt
; toml = taplo fmt -
